<style>
    .btn-search {
        background-color: #fe424d;
        color: #fff;
        border-radius: 25px;
    }

    .btn-search:hover {
        background-color: #fe424d;
        color: #fff;
    }

    .btn-search i {
        display: inline;
    }

    .search-inp {
        border-radius: 25px;
        padding: 0 2rem 0 2rem;
    }

    @media (max-width: 767.98px) {

        /* Search form ko left side align aur full width karne ke liye */
        .search-form {
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding-left: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* Parent container ki alignment left set karne ke liye */
        .navbar-nav.ms-auto {
            margin-left: 0 !important;
            width: 100%;
        }
    }
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo02">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse bg-white" id="navbarTogglerDemo02">
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Explore</a>
            </div>
            <div class="navbar-nav ms-auto">
                <form class="d-flex ms-auto my-2 my-md-0 search-form" role="search" action="/listings" method="get">
                    <input class="form-control search-inp me-2" type="search" name="q"
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                        placeholder="Search destinations" />
                    <button class="btn btn-search" type="submit"><i
                            class="fa-solid fa-magnifying-glass"></i>&nbsp;Search</button>
                </form>
            </div>

            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/listings/new">Add New Place</a>
                <% if(!currUser){ %>
                    <a class="nav-link active" href="/signup"><b>Sign Up</b></a>
                    <a class="nav-link" href="/login"><b>Log In</b></a>
                    <%}%>
                        <% if(currUser){ %>
                            <a class="nav-link" href="/logout"><b>Log Out</b></a>
                            <%}%>
            </div>
        </div>
    </div>
</nav>